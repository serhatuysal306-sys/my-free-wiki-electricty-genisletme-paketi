 "sections": [
  {
   "id": "ozet",
   "title": "Kısaca Elektronik",
   "lead": "Önce temel kavramlar.",
   "type": "n",
   "items": [
    {
     "title": "Elektronik nedir?",
     "tag": "",
     "text": "Elektronik, elektrik akımını kontrol ederek bilgi işleyen, ölçen ve dönüştüren devreleri inceleyen bilim ve uygulama alanıdır.||Bir elektronik devre; kaynak (pil, adaptör), bileşenler ve bunları birbirine bağlayan iletkenlerden oluşur.",
     "keywords": "elektronik devre kaynak bileşen tanım"
    },
    {
     "title": "Güvenlik önce gelir",
     "tag": "",
     "text": "Devreye enerji vermeden önce bağlantıları kontrol edin. Şebeke gerilimiyle (220 V) çalışmak tehlikelidir; bu işleri yetkin bir kişi yapmalıdır.||Kondansatörler kapatıldıktan sonra bile yük tutabilir. Pil ve adaptör bağlarken kutupları (+/−) mutlaka kontrol edin.",
     "keywords": "güvenlik tehlike şebeke 220 kutup kondansatör"
    },
    {
     "title": "Nasıl okunur?",
     "tag": "",
     "text": "Bu wikide her kavram kısa bir açıklama ile başlar. Üstteki arama kutusuna bir kelime yazarak tüm bölümlerde arama yapabilirsiniz; bulunan kelimeler sarı işaretlenir.",
     "keywords": "nasıl kullanılır arama yardım"
    }
   ]
  },
  {
   "id": "temel",
   "title": "Temel Kavramlar",
   "lead": "Her devrenin dayandığı üç büyüklük.",
   "type": "n",
   "items": [
    {
     "title": "Gerilim (Volt, V)",
     "tag": "V",
     "text": "İki nokta arasındaki elektriksel potansiyel farkıdır. Suyun yükseklik farkına benzetilir: yükseklik farkı ne kadar büyükse su o kadar hızlı akar.",
     "keywords": "gerilim volt potansiyel su benzetme"
    },
    {
     "title": "Akım (Amper, A)",
     "tag": "A",
     "text": "Birim zamanda iletkenin kesitinden geçen yük miktarıdır. Borudan akan suyun miktarına benzetilir.||Devreden geçen akım, bileşenlerin dayanabileceği değerleri aşmamalıdır; aşarsa ısınır ve zarar görürler.",
     "keywords": "akım amper yük boru ısınma"
    },
    {
     "title": "Direnç (Ohm, Ω)",
     "tag": "Ω",
     "text": "Akıma karşı gösterilen zorluktur. Borudaki daralmaya benzetilebilir. Dirençler akımı sınırlamak ve gerilimi bölmek için kullanılır.",
     "keywords": "direnç ohm omega sınırlama bölme"
    },
    {
     "title": "Ohm yasası",
     "tag": "V = I × R",
     "text": "Gerilim, akım ile direncin çarpımına eşittir: V = I × R. Buradan akım I = V / R ve direnç R = V / I bulunur.||Örnek: 9 V’luk bir pile 300 Ω’luk bir direnç bağlanırsa devreden 9 / 300 = 0,03 A (30 mA) akar.",
     "keywords": "ohm yasası formül v i r hesap 9 volt 300 ohm"
    },
    {
     "title": "Güç (Watt, W)",
     "tag": "P = V × I",
     "text": "Bir bileşenin birim zamanda harcadığı veya ürettiği enerjidir. P = V × I formülüyle hesaplanır.||Bir direncin dayanabileceği güç, wattla belirtilir (örn. 1/4 W). Hesaplanan gücü aşan bir direnç ısınıp bozulabilir.",
     "keywords": "güç watt p vi hesap 1/4 w"
    },
    {
     "title": "Doğru akım ve alternatif akım",
     "tag": "",
     "text": "DC (doğru akım) tek yönde akar; piller ve USB girişleri DC’dir. AC (alternatif akım) yönünü periyodik olarak değiştirir; şebeke elektriği AC’dir.||Adaptörler AC’yi, cihazın ihtiyaç duyduğu DC gerilime çevirir.",
     "keywords": "dc ac doğru alternatif adaptör usb pil şebeke"
    }
   ]
  },
  {
   "id": "devre",
   "title": "Devre Türleri",
   "lead": "Bileşenlerin bağlanma biçimleri.",
   "type": "n",
   "items": [
    {
     "title": "Seri bağlantı",
     "tag": "",
     "text": "Bileşenler tek bir yol üzerinde ardışık bağlanır. Aynı akım tüm bileşenlerden geçer; gerilim bileşenler arasında bölünür.||Bir bileşen koparsa devre tamamen kesilir.",
     "keywords": "seri bağlantı akım bölünme kopma"
    },
    {
     "title": "Paralel bağlantı",
     "tag": "",
     "text": "Bileşenlerin uçları ortak noktalara bağlanır. Her bileşende gerilim aynıdır; akım dallara bölünür.||Bir dal koparsa diğerleri çalışmaya devam eder. Ev prizleri paralel bağlıdır.",
     "keywords": "paralel bağlantı gerilim dal priz ev"
    },
    {
     "title": "Kısa devre",
     "tag": "",
     "text": "Direncin çok küçük olduğu veya iki iletkenin doğrudan birbirine temas ettiği durumdur. Akım çok artar; kablo ısınır, sigorta atar, pil veya adaptör hasar görebilir.",
     "keywords": "kısa devre sigorta ısınma tehlike"
    },
    {
     "title": "Açık devre",
     "tag": "",
     "text": "Akım yolunun kopuk olduğu durumdur. Akım akmaz; bağlantıları ve lehim noktalarını kontrol etmek gerekir.",
     "keywords": "açık devre kopuk akım yok kontrol"
    }
   ]
  },
  {
   "id": "bilesenler",
   "title": "Pasif Bileşenler",
   "lead": "Enerji üretmeyen, sadece davranışını değiştiren parçalar.",
   "type": "n",
   "items": [
    {
     "title": "Direnç",
     "tag": "",
     "text": "Akımı sınırlar, gerilimi böler, LED’lere ve sinyallere uygun seviyeleri sağlar. Değeri ohm (Ω) ile ölçülür.||Ayak uzunluğu bağlantıya ve yüze göre değişmez; yön fark etmez.",
     "keywords": "direnç akım sınırlama gerilim bölücü led yön"
    },
    {
     "title": "Kondansatör",
     "tag": "",
     "text": "Elektrik yükünü bir süre depolar. Değeri farad (F) ile ölçülür; genellikle µF, nF veya pF kullanılır.||Güç hattını yumuşatmak, gürültüyü filtrelemek ve zamanlama devrelerinde kullanılır. Elektrolitik kondansatörlerde (+) ve (−) bacakları vardır; ters takılırsa patlayabilir.",
     "keywords": "kondansatör farad filtre elektrolitik kutup patlama"
    },
    {
     "title": "Bobin (indüktör)",
     "tag": "",
     "text": "Tel sarılarak yapılır ve akım değişimine karşı çıkar. Manyetik alan depolar.||Güç kaynaklarında filtreleme, radyo devrelerinde seçim ve transformatörlerde kullanılır.",
     "keywords": "bobin indüktör manyetik alan transformatör filtre"
    },
    {
     "title": "Potansiyometre",
     "tag": "",
     "text": "Ayarlanabilir dirençtir. Ses kısma düğmesi bir potansiyometre örneğidir. Üç bacağı vardır: iki uç ve ortadaki kaydırıcı.",
     "keywords": "potansiyometre ayarlanabilir ses düğme"
    }
   ]
  },
  {
   "id": "yari",
   "title": "Yarı İletken Elemanlar",
   "lead": "Akımı tek yönde geçiren veya kontrol eden parçalar.",
   "type": "n",
   "items": [
    {
     "title": "Diyot",
     "tag": "",
     "text": "Akımı yalnızca bir yönde geçirir. Anot (+) ve katot (−) uçları vardır; katot genellikle gövdede bir çizgiyle işaretlenir.||AC’yi DC’ye çevirmek (doğrultma) için kullanılır.",
     "keywords": "diyot anot katot doğrultma tek yön"
    },
    {
     "title": "LED",
     "tag": "",
     "text": "Işık yayan diyottur. Uzun bacak genellikle (+) anottur. LED’in yanması için bir direnç ile seri bağlanması gerekir; aksi halde aşırı akım LED’i bozar.",
     "keywords": "led ışık yayan diyot direnç uzun bacak anot"
    },
    {
     "title": "Transistör",
     "tag": "",
     "text": "Küçük bir akım veya gerilimle büyük bir akımı kontrol eden anahtar veya yükselteçtir. Üç bacağı vardır: taban (B), kollektör (C) ve emetör (E) (NPN ve PNP tipleri vardır).||Dijital devrelerde anahtar, analog devrelerde sinyal yükseltici olarak kullanılır.",
     "keywords": "transistör npn pnp taban kollektör emetör anahtar yükselteç"
    },
    {
     "title": "Entegre devre (IC)",
     "tag": "",
     "text": "Çok sayıda transistör, direnç ve diğer elemanın tek bir kılıfa yerleştirilmiş hâlidir. Zamanlayıcılar, mikrodenetleyiciler ve ses yükselteçleri birer entegredir.||Entegrenin bacak numarasını bulmak için üzerindeki çentik veya noktaya bakın; numaralandırma bu işaretten başlar.",
     "keywords": "entegre ic mikrodenetleyici zamanlayıcı çentik bacak"
    }
   ]
  },
