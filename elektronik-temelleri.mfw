  {
   "id": "lehim",
   "title": "Lehimleme ve Montaj",
   "lead": "Bileşenleri kartta kalıcı hâle getirmek.",
   "type": "n",
   "items": [
    {
     "title": "Lehim ve lehim teli",
     "tag": "",
     "text": "Kalay-kurşun veya kurşunsuz lehim teli kullanılır. Kurşunlu lehimden sonra ellerinizi yıkayın ve iyi havalandırılmış bir ortamda çalışın.||Lehim yapılacak yüzeyler temiz ve yağsız olmalıdır.",
     "keywords": "lehim kalay kurşun havalandırma temizlik"
    },
    {
     "title": "Doğru lehim tekniği",
     "tag": "",
     "text": "Havyayı hem pede hem bacağa aynı anda değdirin, birkaç saniye ısıtın, sonra lehim telini pede değdirin. Lehim akıp pedi ve bacağı sararsa işlem tamamdır; havyayı çekin.||Uzun süre ısıtmak pedi kaldırabilir veya bileşeni bozabilir.",
     "keywords": "lehim tekniği havya ped bacak sıcaklık soğuk lehim"
    },
    {
     "title": "Soğuk lehim",
     "tag": "",
     "text": "Lehim mat, parçalı veya topak şeklinde görünüyorsa ve bağlantı zayıfsa soğuk lehim oluşmuştur. Yeniden ısıtıp parlak bir birleşme oluşturun.",
     "keywords": "soğuk lehim mat topak zayıf bağlantı"
    },
    {
     "title": "Breadboard (deneme tahtası)",
     "tag": "",
     "text": "Lehim yapmadan devre kurmaya yarayan tahtadır. Delikler içeride metal şeritlerle bağlıdır; bileşenler bacaklarıyla deliklere takılır.||Denemeler için idealdir, ancak kalıcı kullanım için uygun değildir.",
     "keywords": "breadboard deneme tahtası lehimsiz delik şerit"
    }
   ]
  },
